<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/corner_radius_small" android:bottomLeftRadius="@dimen/corner_radius_small" />
            <stroke android:width="@dimen/outline_border_small" android:color="@color/primary_600_30" />
            <solid android:color="@color/primary_100" />
        </shape>
    </item>
    <item android:state_enabled="true" android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="@dimen/corner_radius_small" android:bottomLeftRadius="@dimen/corner_radius_small" />
                    <stroke android:width="@dimen/outline_border_small" android:color="@color/primary_600" />
                    <solid android:color="@color/primary_300" />
                </shape>
            </item>
            <item android:right="-1.0dip">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="@dimen/corner_radius_small" android:bottomLeftRadius="@dimen/corner_radius_small" />
                    <stroke android:width="@dimen/outline_border_small" android:color="@color/primary_600" />
                    <solid android:color="@color/primary_300" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="@dimen/corner_radius_small" android:bottomLeftRadius="@dimen/corner_radius_small" />
                    <stroke android:width="@dimen/outline_border_small" android:color="@color/primary_600" />
                </shape>
            </item>
            <item android:right="-1.0dip">
                <shape android:shape="rectangle">
                    <corners android:topLeftRadius="@dimen/corner_radius_small" android:bottomLeftRadius="@dimen/corner_radius_small" />
                    <stroke android:width="@dimen/outline_border_small" android:color="@color/primary_600" />
                    <solid android:color="@color/neutral_100" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>