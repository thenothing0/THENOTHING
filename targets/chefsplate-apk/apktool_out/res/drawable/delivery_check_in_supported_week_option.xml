<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_200" />
            <stroke android:width="@dimen/outline_border_medium" android:color="@color/primary_600" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_200" />
            <stroke android:width="@dimen/outline_border_medium" android:color="@color/primary_600" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/neutral_100" />
            <stroke android:width="@dimen/outline_border_small" android:color="@color/primary_600" />
        </shape>
    </item>
</selector>