/* HYDRA TUI — Light theme */

Screen {
    background: #ffffff;
    color: #24292e;
}

#workspace {
    layout: horizontal;
    height: 1fr;
}

#main-area {
    width: 1fr;
    layout: vertical;
}

ConversationLog {
    height: 1fr;
    background: #ffffff;
    scrollbar-background: #f6f8fa;
    scrollbar-color: #d0d7de;
    scrollbar-size: 1 1;
}

CommandInput {
    background: #f6f8fa;
    color: #24292e;
    height: 1;
}

CommandInput:focus {
    background: #eaeef2;
}

StatusBar {
    dock: bottom;
    background: #f6f8fa;
    color: #57606a;
    height: 1;
}

Sidebar {
    background: #f6f8fa;
    border-right: solid #d0d7de;
    width: 28;
    padding: 1;
}

WorkflowBar {
    height: 1;
    background: #f6f8fa;
    padding: 0 1;
}

BottomPanel {
    height: 12;
    background: #ffffff;
    border-top: solid #d0d7de;
    display: none;
    scrollbar-size: 1 1;
}

BottomPanel.open {
    display: block;
}

ContextDrawer {
    width: 45;
    background: #f6f8fa;
    border-left: solid #d0d7de;
    padding: 1 2;
    display: none;
}

ContextDrawer.open {
    display: block;
}

Inspector {
    background: #ffffff;
    border: solid #d0d7de;
    padding: 1 2;
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
}

Inspector.open {
    display: block;
}

ToolOutput {
    height: 1fr;
    background: #ffffff;
}

.hidden {
    display: none;
}
