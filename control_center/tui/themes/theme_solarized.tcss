/* HYDRA TUI — Solarized Dark theme */

Screen {
    background: #002b36;
    color: #839496;
}

#workspace {
    layout: horizontal;
    height: 1fr;
}

#main-area {
    width: 1fr;
    layout: vertical;
}

ConversationLog {
    height: 1fr;
    background: #002b36;
    scrollbar-background: #073642;
    scrollbar-color: #586e75;
    scrollbar-size: 1 1;
}

CommandInput {
    background: #073642;
    color: #93a1a1;
    height: 1;
}

CommandInput:focus {
    background: #073642;
}

StatusBar {
    dock: bottom;
    background: #073642;
    color: #657b83;
    height: 1;
}

Sidebar {
    background: #002b36;
    border-right: solid #586e75;
    width: 28;
    padding: 1;
}

WorkflowBar {
    height: 1;
    background: #073642;
    padding: 0 1;
}

BottomPanel {
    height: 12;
    background: #002b36;
    border-top: solid #586e75;
    display: none;
    scrollbar-size: 1 1;
}

BottomPanel.open {
    display: block;
}

ContextDrawer {
    width: 45;
    background: #073642;
    border-left: solid #586e75;
    padding: 1 2;
    display: none;
}

ContextDrawer.open {
    display: block;
}

Inspector {
    background: #002b36;
    border: solid #586e75;
    padding: 1 2;
    display: none;
    layer: overlay;
    width: 100%;
    height: 100%;
}

Inspector.open {
    display: block;
}

ToolOutput {
    height: 1fr;
    background: #002b36;
}

.hidden {
    display: none;
}
